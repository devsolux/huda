* text=auto
*.rs text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
# The shared lock is hashed byte-for-byte across native jobs; Windows must not see CRLF.
Cargo.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.desktop text eol=lf
*.manifest text eol=lf
*.iss text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.icns binary
# The authoritative plan's byte hash must be identical on every native checkout.
/assets/icons/source.png -text
